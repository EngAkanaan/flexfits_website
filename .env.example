# Browser-visible Vite configuration. Never put private secrets in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
VITE_SITE_URL=http://localhost:3000

# Server-only Vercel Function configuration.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
EMAIL_WEBHOOK_URL=https://YOUR_EMAIL_PROVIDER_WEBHOOK
EMAIL_WEBHOOK_SECRET=YOUR_EMAIL_WEBHOOK_SECRET
ORDER_NOTIFICATION_EMAIL=orders@example.com
SITE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
